# Copy to .env and fill in credentials from a Google Cloud desktop OAuth client.
# Enable Google Drive API, YouTube Data API, and YouTube Analytics API for that project.
#
# `login` requests these scopes:
#   https://www.googleapis.com/auth/drive.readonly
#   https://www.googleapis.com/auth/drive.file
#   https://www.googleapis.com/auth/youtube.force-ssl
#   https://www.googleapis.com/auth/yt-analytics.readonly
# drive.readonly reads the story inbox and finds an existing stats file.
# drive.file creates and overwrites that stats file. It does not edit story videos.
# youtube.force-ssl uploads and reads the channel.
# yt-analytics.readonly reads YouTube Analytics reports.query.
# Re-run login after this list changes. An older token keeps working for uploads,
# but export-stats refuses to run until the new scopes are granted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The login command will save/refresh OAuth tokens here.
GOOGLE_TOKEN_PATH=secrets/token.json
